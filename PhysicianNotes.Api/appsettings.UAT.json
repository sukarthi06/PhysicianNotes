{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "" //Use comma to add multiple origins e.g., http://localhost:4200,http://localhost:4201
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "openai/gpt-4.1-mini",
    "Endpoint": "https://models.github.ai/inference"
  },
  "RecordingGrpcService": {
    "Address": "https://stt-recordinggrpcservice-dev.azurewebsites.net"
  },
  "ClinicalGrpcService": {
    "Address": "https://stt-clinicalgrpcservice-dev.azurewebsites.net"
  },
  "Azure": {
    "StorageConnectionString": "",
    "SourceContainer": "transcripts",
    "ClinicalContainer": "clinical-transcripts"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
