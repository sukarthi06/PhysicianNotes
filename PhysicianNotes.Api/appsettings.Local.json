{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:4200" //Use comma to add multiple origins e.g., http://localhost:4200,http://localhost:4201
  },
  "OpenAI": {
    "ApiKey": "",
    "Model": "openai/gpt-4.1-mini",
    "Endpoint": "https://models.github.ai/inference"
  },
  "RecordingGrpcService": {
    "Address": "http://localhost:5283"
  },
  "ClinicalGrpcService": {
    "Address": "http://localhost:5097"
  },
  "Azure": {
    "StorageConnectionString": "UseDevelopmentStorage=true",
    "SourceContainer": "transcripts",
    "ClinicalContainer": "clinical-transcripts"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}